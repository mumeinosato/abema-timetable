{
  "manifest_version": 3,
  "name": "Abema Timetable",
  "description": "Abema's timetable to show only what you need",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["https://abema.tv/*"],
      "js": ["index.js"]
    }
  ]
}